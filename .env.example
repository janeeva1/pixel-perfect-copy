# Local setup for the Attendance Register. Copy to .env and edit as needed.
# Nothing here leaves your machine.

# --- MySQL / MariaDB (XAMPP defaults) -------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=attendance
DB_POOL_SIZE=10

# --- Sessions -------------------------------------------------------------
# Signs the login cookie. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# --- Local server ---------------------------------------------------------
PORT=3000
HOST=127.0.0.1

# --- Shared sync hub (optional) -------------------------------------------
# Only needed to synchronize with other copies. Leave these out and the
# Synchronize button on the Admin page stays disabled; nothing else changes.
#
# Create the database yourself first — synchronization creates its tables, not
# the database. Every machine that synchronizes must name the same one, and it
# should be a database of its own: its table names match the app's, so pointing
# this at the database the hosted app uses will mix the two schemas.
#
# In the desktop app put these in a file named sync.env beside the database
# (%APPDATA%\attendance-register\sync.env). A template is written there on first
# run. Only SYNC_DB_* names are read from that file, so it cannot disturb the
# local database.
SYNC_DB_HOST=
SYNC_DB_NAME=
SYNC_DB_PORT=3306
SYNC_DB_USER=root
SYNC_DB_PASSWORD=
